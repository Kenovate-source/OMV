// OMV Phase 5 — Prisma schema
//
// Implements the architecture locked across three Phase 5 planning rounds.
// See docs/adr/001-backend-architecture.md and 002-variant-identity.md.
//
// This version includes the Milestone 1 final schema audit's corrections:
//   - ProductVariant.product no longer cascades on delete.
//   - User.isActive added (account deactivation).
//   - Payment.refundedAmount added.
//   - Redundant @@index entries removed where a sibling @unique already
//     creates an equivalent index.
//
// Conventions: all monetary fields are Int (kobo, never Decimal/Float);
// currency stored explicitly; createdAt/updatedAt on every mutable model;
// soft-delete via deletedAt on Product only — Order/Payment are never
// deleted, only status-transitioned (service-layer discipline, not
// schema-enforced — see AuditLog comment below).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER
  BUSINESS
  STAFF
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ProductCategory {
  WOMEN
  MEN
  KIDS
}

enum GarmentSlot {
  TOP
  SHIRT
  DRESS
  JACKET
  TROUSERS
  SKIRT
  TRADITIONAL_WEAR
  SHOES
  BAG
  HEADWEAR
  ACCESSORY
  NONE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  INITIALIZED
  PENDING
  VERIFIED
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementType {
  INFO
  PROMOTION
  MAINTENANCE
  LAUNCH
}

enum ContactType {
  PHONE
  WHATSAPP
  EMAIL
}

enum ContactPurpose {
  STORE_LINE
  CUSTOMER_SERVICE
  DELIVERY
  SALES
  MARKETING
  BRANCH
}

enum LocationType {
  STORE
  WAREHOUSE
  PICKUP
  OFFICE
}

enum ProposedChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  passwordHash  String
  fullName      String
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses           Address[]
  orders              Order[]
  wishlistItems       WishlistItem[]
  reviews             Review[]
  familyMembers       FamilyMember[]
  stylePreference     StylePreference?
  savedOutfits        SavedOutfit[]
  notificationPrefs   NotificationPreference?
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerificationToken[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  fullName  String
  phone     String
  line1     String
  city      String
  state     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         AdminRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  adminNotifications  AdminNotification[]
  proposedChanges     ProposedChange[] @relation("ProposedBy")
  reviewedChanges     ProposedChange[] @relation("ReviewedBy")
}

model Session {
  id               String     @id @default(cuid())
  userId           String?
  user             User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId      String?
  adminUser        AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String     @unique
  deviceInfo       String?
  createdAt        DateTime   @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
  @@index([adminUserId])
}

model PasswordResetToken {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String     @unique
  createdAt   DateTime   @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  @@index([userId])
  @@index([adminUserId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model Product {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String          @default("")
  department  String          @default("Fashion")
  category    ProductCategory
  subcategory String?
  garmentSlot GarmentSlot     @default(NONE)
  price       Int
  salePrice   Int?
  currency    String          @default("NGN")
  status      ProductStatus   @default(ACTIVE)
  badge       String?
  swatchFrom  String?
  swatchTo    String?
  attributes  Json            @default("{}")
  tags        String[]        @default([])
  featured    Boolean         @default(false)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  variants          ProductVariant[]
  reviews           Review[]
  wishlistItems     WishlistItem[]
  completeTheLookOf CompleteTheLookLink[] @relation("SourceProduct")
  completeTheLookTo CompleteTheLookLink[] @relation("RelatedProduct")

  @@index([category])
  @@index([status])
  @@index([deletedAt])
}

model CompleteTheLookLink {
  id               String  @id @default(cuid())
  sourceProductId  String
  sourceProduct    Product @relation("SourceProduct", fields: [sourceProductId], references: [id], onDelete: Cascade)
  relatedProductId String
  relatedProduct   Product @relation("RelatedProduct", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, relatedProductId])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  color      String?
  size       String?
  attributes Json     @default("{}")
  variantKey String
  stock      Int      @default(0)
  reserved   Int      @default(0)
  sku        String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, variantKey])
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  userId               String
  user                 User        @relation(fields: [userId], references: [id])
  status               OrderStatus @default(PENDING_PAYMENT)
  subtotal             Int
  discountAmount       Int         @default(0)
  total                Int
  currency             String      @default("NGN")
  promotionId          String?
  promotion            Promotion?  @relation(fields: [promotionId], references: [id])
  shippingFullName     String
  shippingPhone        String
  shippingLine1        String
  shippingCity         String
  shippingState        String
  reservationExpiresAt DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([reservationExpiresAt])
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productName      String
  color            String?
  size             String?
  quantity         Int
  priceAtPurchase  Int
  currency         String         @default("NGN")

  @@index([orderId])
  @@index([productVariantId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  provider          String
  reference         String        @unique
  transactionId     String?
  amount            Int
  currency          String        @default("NGN")
  status            PaymentStatus @default(INITIALIZED)
  refundedAmount    Int?
  verifiedAt        DateTime?
  rawWebhookPayload Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

model PaymentProviderConfig {
  id           String   @id @default(cuid())
  provider     String   @unique
  isActive     Boolean  @default(false)
  isDefault    Boolean  @default(false)
  publicConfig Json     @default("{}")
  secretEnvKey String
  updatedAt    DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  customerName String
  rating       Int
  comment      String
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([productId])
  @@index([status])
}

model Promotion {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int
  active          Boolean   @default(true)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders Order[]
}

model Announcement {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      AnnouncementType @default(INFO)
  startDate DateTime
  endDate   DateTime
  active    Boolean          @default(true)
  ctaLabel  String?
  ctaHref   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([active, startDate, endDate])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Policy {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContentRevision {
  id           String    @id @default(cuid())
  targetType   String
  targetId     String
  payload      Json
  publishedAt  DateTime?
  rolledBackAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([targetType, targetId])
}

model ProposedChange {
  id                String               @id @default(cuid())
  proposedByAdminId String?
  proposedByAdmin   AdminUser?           @relation("ProposedBy", fields: [proposedByAdminId], references: [id])
  proposedByAI      Boolean              @default(false)
  targetType        String
  targetId          String?
  payload           Json
  status            ProposedChangeStatus @default(PENDING)
  reviewedByAdminId String?
  reviewedByAdmin   AdminUser?           @relation("ReviewedBy", fields: [reviewedByAdminId], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime             @default(now())

  @@index([status])
}

model NotificationPreference {
  userId   String  @id
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email    Boolean @default(true)
  sms      Boolean @default(false)
  whatsapp Boolean @default(true)
  push     Boolean @default(true)
}

model AdminNotification {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  message     String
  href        String?
  read        Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([adminUserId, read])
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([createdAt])
}

model FamilyMember {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  relationship       String
  ageGroup           String
  genderPresentation String?
  clothingSizes      Json     @default("{}")
  shoeSize           String?
  stylePreferences   String[] @default([])
  colorPreferences   String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

model StylePreference {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteColors        String[] @default([])
  fitPreference         String?
  favoriteClothingTypes String[] @default([])
  favoriteStyles        String[] @default([])
  preferredShoes        String[] @default([])
  preferredAccessories  String[] @default([])
  commonOccasions       String[] @default([])
  formality             String?
  updatedAt             DateTime @updatedAt
}

model SavedOutfit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  occasion  String?
  createdAt DateTime @default(now())

  items SavedOutfitItem[]

  @@index([userId])
}

model SavedOutfitItem {
  id            String      @id @default(cuid())
  savedOutfitId String
  savedOutfit   SavedOutfit @relation(fields: [savedOutfitId], references: [id], onDelete: Cascade)
  productId     String
  slot          GarmentSlot
  size          String?

  @@index([savedOutfitId])
}

model BusinessLocation {
  id                String       @id @default(cuid())
  name              String
  type              LocationType
  addressLine       String
  city              String
  state             String
  hours             Json         @default("{}")
  deliveryAvailable Boolean      @default(false)
  pickupAvailable   Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  contactPoints ContactPoint[]
}

model ContactPoint {
  id         String            @id @default(cuid())
  locationId String?
  location   BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  type       ContactType
  purpose    ContactPurpose
  value      String
  label      String?
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())

  @@index([locationId])
}
